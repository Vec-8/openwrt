From: OTB local build <noreply@localhost>
Subject: [PATCH] net: dsa: mxl862xx: program phylink pause state

MxL862xx advertises symmetric and asymmetric pause support, but its
mac_link_up callback is empty. Consequently pause settings resolved by
phylink, including manual settings made through ethtool/netifd, never reach
the switch firmware and the port remains at its firmware default.

Read the complete port configuration, update only flow_ctrl and write the
structure back. Keep half-duplex links with pause disabled.

This change intentionally does not alter QoS/WRED thresholds. Those remain
subject to a separate, reversible hardware validation on the BPI-R4 Pro.
---
--- a/drivers/net/dsa/mxl862xx/mxl862xx-cmd.h
+++ b/drivers/net/dsa/mxl862xx/mxl862xx-cmd.h
@@ -29,6 +29,7 @@
 
 #define MXL862XX_COMMON_PORTLINKCFGGET	(MXL862XX_COMMON_MAGIC + 0x5)
 #define MXL862XX_COMMON_PORTCFGGET	(MXL862XX_COMMON_MAGIC + 0x7)
+#define MXL862XX_COMMON_PORTCFGSET	(MXL862XX_COMMON_MAGIC + 0x8)
 #define MXL862XX_COMMON_CFGGET		(MXL862XX_COMMON_MAGIC + 0x9)
 #define MXL862XX_COMMON_CFGSET		(MXL862XX_COMMON_MAGIC + 0xa)
 #define MXL862XX_COMMON_MONITORPORTCFGSET (MXL862XX_COMMON_MAGIC + 0xe)
--- a/drivers/net/dsa/mxl862xx/mxl862xx-phylink.c
+++ b/drivers/net/dsa/mxl862xx/mxl862xx-phylink.c
@@ -532,6 +532,36 @@
 	}
 }
 
+static int mxl862xx_phylink_set_pause(struct mxl862xx_priv *priv, int port,
+				      bool tx_pause, bool rx_pause)
+{
+	struct mxl862xx_port_cfg port_cfg = {
+		.port_id = cpu_to_le16(port),
+	};
+	enum mxl862xx_port_flow flow_ctrl;
+	int ret;
+
+	if (tx_pause && rx_pause)
+		flow_ctrl = MXL862XX_FLOW_RXTX;
+	else if (tx_pause)
+		flow_ctrl = MXL862XX_FLOW_TX;
+	else if (rx_pause)
+		flow_ctrl = MXL862XX_FLOW_RX;
+	else
+		flow_ctrl = MXL862XX_FLOW_OFF;
+
+	ret = MXL862XX_API_READ(priv, MXL862XX_COMMON_PORTCFGGET, port_cfg);
+	if (ret)
+		return ret;
+
+	if (le32_to_cpu(port_cfg.flow_ctrl) == flow_ctrl)
+		return 0;
+
+	port_cfg.flow_ctrl = cpu_to_le32(flow_ctrl);
+
+	return MXL862XX_API_WRITE(priv, MXL862XX_COMMON_PORTCFGSET, port_cfg);
+}
+
 static void mxl862xx_phylink_mac_config(struct phylink_config *config,
 					unsigned int mode,
 					const struct phylink_link_state *state)
@@ -551,6 +581,20 @@
 					 int speed, int duplex,
 					 bool tx_pause, bool rx_pause)
 {
+	struct dsa_port *dp = dsa_phylink_to_port(config);
+	struct mxl862xx_priv *priv = dp->ds->priv;
+	int ret;
+
+	if (duplex != DUPLEX_FULL) {
+		tx_pause = false;
+		rx_pause = false;
+	}
+
+	ret = mxl862xx_phylink_set_pause(priv, dp->index, tx_pause, rx_pause);
+	if (ret)
+		dev_err(priv->ds->dev,
+			"failed to configure pause on port %d: %d\n",
+			dp->index, ret);
 }
 
 const struct phylink_mac_ops mxl862xx_phylink_mac_ops = {
