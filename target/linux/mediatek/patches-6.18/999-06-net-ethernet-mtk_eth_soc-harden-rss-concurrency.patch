From: OpenAI Codex <codex@localhost>
Date: Mon, 27 Jul 2026 05:00:00 +0200
Subject: [PATCH] net: ethernet: mtk_eth_soc: harden multi-ring RSS

The v8 RSS backport introduces multiple RX NAPI instances but retains one
shared set of Net DIM counters and one struct dim. Concurrent updates from
several CPUs race and feed corrupted samples to interrupt moderation.

Keep adaptive RX DIM on the legacy single-NAPI path and use the initial
static moderation profile for RSS/HW-LRO. Serialize overflow status
handling, process it only from RX ring 0, validate and pause runtime RSS
configuration updates, and avoid exposing RSS register operations on
unsupported SoCs.

Also request only pdma0 on non-RSS SoCs and gate LRO delay-register writes
on the actual HW-LRO capability, avoiding writes through zero register-map
offsets on MT7628.

Signed-off-by: OpenAI Codex <codex@localhost>
---
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
index 3fe5daf..182e13c 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -2638,11 +2638,18 @@ rx_done:
 		mtk_update_rx_cpu_idx(eth, ring);
 	}
 
-	eth->rx_packets += done;
-	eth->rx_bytes += bytes;
-	dim_update_sample(eth->rx_events, eth->rx_packets, eth->rx_bytes,
-			  &dim_sample);
-	net_dim(&eth->rx_dim, &dim_sample);
+	/*
+	 * RSS and HW LRO use several RX NAPI instances concurrently.  The
+	 * legacy DIM counters and struct dim are shared, so only use adaptive
+	 * RX moderation while a single RX NAPI owns them.
+	 */
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_RSS) && !eth->hwlro) {
+		eth->rx_packets += done;
+		eth->rx_bytes += bytes;
+		dim_update_sample(eth->rx_events, eth->rx_packets,
+				  eth->rx_bytes, &dim_sample);
+		net_dim(&eth->rx_dim, &dim_sample);
+	}
 
 	if (xdp_flush)
 		xdp_do_flush();
@@ -2803,13 +2810,17 @@ static int mtk_poll_tx(struct mtk_eth *eth, int budget)
 
 static void mtk_handle_status_irq(struct mtk_eth *eth)
 {
-	u32 status2 = mtk_r32(eth, MTK_INT_STATUS2);
+	u32 status2;
+
+	spin_lock_bh(&eth->status_lock);
+	status2 = mtk_r32(eth, MTK_INT_STATUS2);
 
 	if (unlikely(status2 & (MTK_GDM1_AF | MTK_GDM2_AF))) {
 		mtk_stats_update(eth);
 		mtk_w32(eth, (MTK_GDM1_AF | MTK_GDM2_AF),
 			MTK_INT_STATUS2);
 	}
+	spin_unlock_bh(&eth->status_lock);
 }
 
 static int mtk_napi_tx(struct napi_struct *napi, int budget)
@@ -2850,7 +2861,8 @@ static int mtk_napi_rx(struct napi_struct *napi, int budget)
 	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
 	int rx_done_total = 0;
 
-	mtk_handle_status_irq(eth);
+	if (!ring->ring_no)
+		mtk_handle_status_irq(eth);
 
 	do {
 		int rx_done;
@@ -3909,9 +3921,13 @@ static int mtk_get_irqs_fe(struct platform_device *pdev, struct mtk_eth *eth)
 static int mtk_get_irqs_pdma(struct platform_device *pdev, struct mtk_eth *eth)
 {
 	char rxring[] = "pdma0";
-	int i;
+	int i, irq_num = 1;
 
-	for (i = 0; i < MTK_PDMA_IRQ_NUM; i++) {
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSS) ||
+	    MTK_HAS_CAPS(eth->soc->caps, MTK_HWLRO))
+		irq_num = MTK_PDMA_IRQ_NUM;
+
+	for (i = 0; i < irq_num; i++) {
 		rxring[4] = '0' + i;
 		eth->irq_pdma[i] = platform_get_irq_byname(pdev, rxring);
 		if (eth->irq_pdma[i] < 0)
@@ -3927,12 +3943,14 @@ static irqreturn_t mtk_handle_irq_rx(int irq, void *priv)
 	struct mtk_eth *eth = rx_napi->eth;
 	struct mtk_rx_ring *ring = rx_napi->rx_ring;
 
-	eth->rx_events++;
 	if (unlikely(!(mtk_r32(eth, eth->soc->reg_map->pdma.irq_status) &
 		       mtk_r32(eth, eth->soc->reg_map->pdma.irq_mask) &
 		       MTK_RX_DONE_INT_RING(eth, ring->ring_no))))
 		return IRQ_NONE;
 
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_RSS) && !eth->hwlro)
+		eth->rx_events++;
+
 	if (likely(napi_schedule_prep(&rx_napi->napi))) {
 		mtk_rx_irq_disable(eth, MTK_RX_DONE_INT_RING(eth, ring->ring_no));
 		__napi_schedule(&rx_napi->napi);
@@ -4481,11 +4499,15 @@ static void mtk_dim_rx(struct work_struct *work)
 		mtk_m32(eth, MTK_PDMA_DELAY_TX_MASK,
 			val << MTK_PDMA_DELAY_TX_PTIME_SHIFT, reg_map->qdma.delay_irq);
 
-	if (BIT(eth->soc->rx.desc_shift) == sizeof(struct mtk_rx_dma)) {
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_RSS)) {
 		mtk_m32(eth, MTK_PDMA_DELAY_RX_MASK, val, reg_map->pdma.delay_irq);
-		mtk_w32(eth, val, reg_map->pdma.lro_rx1_dly_int);
-		mtk_w32(eth, val, reg_map->pdma.lro_rx1_dly_int + 0x4);
-		mtk_w32(eth, val, reg_map->pdma.lro_rx1_dly_int + 0x8);
+		if (eth->hwlro && reg_map->pdma.lro_rx1_dly_int) {
+			mtk_w32(eth, val, reg_map->pdma.lro_rx1_dly_int);
+			mtk_w32(eth, val,
+				reg_map->pdma.lro_rx1_dly_int + 0x4);
+			mtk_w32(eth, val,
+				reg_map->pdma.lro_rx1_dly_int + 0x8);
+		}
 	} else {
 		val = val | (val << MTK_PDMA_DELAY_RX_RING_SHIFT);
 		mtk_w32(eth, val, reg_map->pdma.rx_delay_irq);
@@ -5483,11 +5505,21 @@ static int mtk_set_eee(struct net_device *dev, struct ethtool_keee *eee)
 
 static u32 mtk_get_rxfh_key_size(struct net_device *dev)
 {
+	struct mtk_mac *mac = netdev_priv(dev);
+
+	if (!MTK_HAS_CAPS(mac->hw->soc->caps, MTK_RSS))
+		return 0;
+
 	return MTK_RSS_HASH_KEYSIZE;
 }
 
 static u32 mtk_get_rxfh_indir_size(struct net_device *dev)
 {
+	struct mtk_mac *mac = netdev_priv(dev);
+
+	if (!MTK_HAS_CAPS(mac->hw->soc->caps, MTK_RSS))
+		return 0;
+
 	return MTK_RSS_MAX_INDIRECTION_TABLE;
 }
 
@@ -5498,6 +5530,9 @@ static int mtk_get_rxfh(struct net_device *dev, struct ethtool_rxfh_param *rxfh)
 	struct mtk_rss_params *rss_params = &eth->rss_params;
 	int i;
 
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_RSS))
+		return -EOPNOTSUPP;
+
 	if (rxfh->hfunc)
 		rxfh->hfunc = ETH_RSS_HASH_TOP;	/* Toeplitz */
 
@@ -5521,12 +5556,27 @@ static int mtk_set_rxfh(struct net_device *dev, struct ethtool_rxfh_param *rxfh,
 	struct mtk_eth *eth = mac->hw;
 	struct mtk_rss_params *rss_params = &eth->rss_params;
 	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
+	u32 val;
 	int i;
 
+	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_RSS))
+		return -EOPNOTSUPP;
+
 	if (rxfh->hfunc != ETH_RSS_HASH_NO_CHANGE &&
 	    rxfh->hfunc != ETH_RSS_HASH_TOP)
 		return -EOPNOTSUPP;
 
+	if (rxfh->indir) {
+		for (i = 0; i < MTK_RSS_MAX_INDIRECTION_TABLE; i++)
+			if (rxfh->indir[i] >= MTK_RX_RSS_NUM)
+				return -EINVAL;
+	}
+
+	spin_lock_bh(&eth->dim_lock);
+	val = mtk_r32(eth, reg_map->pdma.rss_glo_cfg);
+	mtk_w32(eth, val | MTK_RSS_CFG_REQ,
+		reg_map->pdma.rss_glo_cfg);
+
 	if (rxfh->key) {
 		memcpy(rss_params->hash_key, rxfh->key,
 		       sizeof(rss_params->hash_key));
@@ -5543,6 +5593,10 @@ static int mtk_set_rxfh(struct net_device *dev, struct ethtool_rxfh_param *rxfh,
 				MTK_RSS_INDR_TABLE_DW(i));
 	}
 
+	mtk_w32(eth, val & ~MTK_RSS_CFG_REQ,
+		reg_map->pdma.rss_glo_cfg);
+	spin_unlock_bh(&eth->dim_lock);
+
 	return 0;
 }
 
@@ -6046,6 +6100,7 @@ static int mtk_probe(struct platform_device *pdev)
 	spin_lock_init(&eth->tx_irq_lock);
 	spin_lock_init(&eth->rx_irq_lock);
 	spin_lock_init(&eth->dim_lock);
+	spin_lock_init(&eth->status_lock);
 
 	eth->rx_dim.mode = DIM_CQ_PERIOD_MODE_START_FROM_EQE;
 	INIT_WORK(&eth->rx_dim.work, mtk_dim_rx);
diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.h b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
index 936203b..8dd763d 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
@@ -1464,6 +1464,8 @@ struct mtk_eth {
 	spinlock_t			page_lock;
 	spinlock_t			tx_irq_lock;
 	spinlock_t			rx_irq_lock;
+	/* Serialize MTK_INT_STATUS2 handling across RX and TX NAPI. */
+	spinlock_t			status_lock;
 	struct net_device		*dummy_dev;
 	struct net_device		*netdev[MTK_MAX_DEVS];
 	struct mtk_mac			*mac[MTK_MAX_DEVS];
