+static int
+mtk_hwlro_sync_ipaddr(struct mtk_eth *eth, struct net_device *override_dev,
+		      bool override_enabled)
+{
+	u32 ipaddr[MTK_MAX_RX_RING_NUM] = {};
+	int first, count = 0;
+	int i, j, k;
+
+	/*
+	 * The DIP table is global to the frame engine, not per MAC. Rebuild
+	 * it from the rules of all LRO-enabled netdevs, deduplicating an IP
+	 * used on several MACs. This avoids stale entries and slot leaks.
+	 */
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		struct net_device *dev = eth->netdev[i];
+		struct mtk_mac *mac;
+		bool enabled;
+
+		if (!dev)
+			continue;
+
+		mac = netdev_priv(dev);
+		enabled = !!(dev->features & NETIF_F_LRO);
+		if (dev == override_dev)
+			enabled = override_enabled;
+
+		/*
+		 * A bond or bridge upper clears NETIF_F_LRO recursively.
+		 * Explicit HW classifier rules are exact TCP/IPv4 destination
+		 * matches, so they remain safe for locally terminated traffic:
+		 * unmatched traffic, including forwarded traffic, stays on the
+		 * normal RSS rings.  A rule is therefore also an explicit
+		 * opt-in to filtered HW-LRO below an upper device.
+		 */
+		if (!enabled && !mac->hwlro_ip_cnt)
+			continue;
+
+		for (j = 0; j < MTK_MAX_LRO_IP_CNT; j++) {
+			u32 ip = mac->hwlro_ip[j];
+
+			if (!ip)
+				continue;
+
+			for (k = 0; k < count; k++)
+				if (ipaddr[k] == ip)
+					break;
+			if (k != count)
+				continue;
+
+			if (count >= MTK_HW_LRO_DIP_NUM(eth))
+				return -ENOSPC;
+			ipaddr[count++] = ip;
+		}
+	}
+
+	first = mtk_is_netsys_v3_or_greater(eth) ? 1 : 0;
+	for (i = 0; i < MTK_HW_LRO_DIP_NUM(eth); i++)
+		mtk_hwlro_inval_ipaddr(eth, first + i);
+
+	for (i = 0; i < count; i++)
+		mtk_hwlro_val_ipaddr(eth, first + i, ipaddr[i]);
+
+	return 0;
 }
 
