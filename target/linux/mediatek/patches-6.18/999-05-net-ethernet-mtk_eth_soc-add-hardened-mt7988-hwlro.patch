+static int mtk_hwlro_ipaddr_idx(struct mtk_mac *mac, unsigned int location)
+{
+	struct mtk_eth *eth = mac->hw;
+	int idx;
+
+	/*
+	 * Keep two deterministic slots per MAC. NETSYS v3 numbers the four
+	 * DIP entries 1..4; older generations use the legacy zero-based map.
+	 * This avoids leaking global DIP slots when a rule is replaced.
+	 */
+	idx = mac->id * MTK_MAX_LRO_IP_CNT + location;
+	if (mtk_is_netsys_v3_or_greater(eth))
+		idx++;
+
+	if (mtk_is_netsys_v3_or_greater(eth)) {
+		if (idx > MTK_HW_LRO_DIP_NUM(eth))
+			return -ENOSPC;
+	} else if (idx >= MTK_HW_LRO_DIP_NUM(eth)) {
+		return -ENOSPC;
+	}
+
+	return idx;
+}
