#!/bin/sh /etc/rc.common

START=96
STOP=04
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/otb-overview-loop
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/sbin/otb-overview-snapshot >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger otb-overview otb_devices dhcp wireless
}
