#!/usr/bin/env ucode

'use strict';

import { readfile } from 'fs';

const STATUS_FILE = '/tmp/otb-overview/status.json';

function fallback(error) {
	return {
		schema: 1,
		collected_at: null,
		age_s: null,
		stale: true,
		error: error || 'État OTB indisponible',
		role: 'unknown',
		role_label: 'OpenWrt',
		supervision: {
			scope: 'infrastructure',
			devices: [],
			summary: { total: 0, online: 0, offline: 0, planned: 0 }
		},
		wans: [],
		wifi: { radios: [], interfaces: [], radios_up: 0, mlo_active: 0 },
		services: [],
		storage: []
	};
}

const methods = {
	status: {
		call: function() {
			let raw = readfile(STATUS_FILE);
			if (raw == null)
				return fallback('Premier relevé en attente');

			let data;
			try { data = json(raw); }
			catch (e) { return fallback('Relevé OTB invalide'); }

			let collected = +data.collected_at || null;
			let age = collected == null ? null : time() - collected;
			data.age_s = age;
			data.stale = age == null || age > 180;

			return data;
		}
	}
};

return { 'luci.otb_overview': methods };
