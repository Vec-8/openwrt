From: OTB build <local@otb.invalid>
Subject: [PATCH] wifi: mt76: add MT7990 AP performance profile

Port the MediaTek MT7990 TPO and low-power commands without the vendor-only
debugfs dependency.  For this fixed AP deployment, enable only PB-TPO and
disable L1SS, Ultra Save, 1-Rx packet detection and PST by default.
Regulatory limits and the upstream TX power-limit tables remain unchanged.

Based on MediaTek patch 0069 (Peter Chiu) and the MT7990 hardware capability
parsing from patch 0068.
---
--- a/mt76_connac_mcu.h
+++ b/mt76_connac_mcu.h
@@ -1358,6 +1358,7 @@
 	MCU_UNI_CMD_RADIO_STATUS = 0x80,
 	MCU_UNI_CMD_MLD = 0x82,
 	MCU_UNI_CMD_SDO = 0x88,
+	MCU_UNI_CMD_TPO = 0x8b,
 };
 
 enum {
--- a/mt7996/eeprom.c
+++ b/mt7996/eeprom.c
@@ -269,6 +269,7 @@
 					    u8 *path, u8 *rx_path, u8 *nss)
 {
 #define MODE_HE_ONLY		BIT(0)
+#define PWR_BOOST_CAP		BIT(7)
 #define WTBL_SIZE_GROUP		GENMASK(31, 28)
 #define STREAM_CAP(_offs)	((cap & (0x7 << (_offs))) >> (_offs))
 	struct mt7996_dev *dev = phy->dev;
@@ -287,6 +288,12 @@
 		*nss = min_t(u8, *nss, STREAM_CAP(1 + band_offs));
 		*path = min_t(u8, *path, STREAM_CAP(10 + band_offs));
 		*rx_path = min_t(u8, *rx_path, STREAM_CAP(19 + band_offs));
+
+		if (is_mt7990(&dev->mt76))
+			dev->pwr_boost_cap = !!(cap & PWR_BOOST_CAP);
+	} else if (is_mt7990(&dev->mt76)) {
+		/* Internal/development samples may not expose this capability word. */
+		dev->pwr_boost_cap = true;
 	}
 
 	if (dev->wtbl_size_group < 2 || dev->wtbl_size_group > 4)
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -8,11 +8,16 @@
 #include <linux/hwmon.h>
 #include <linux/hwmon-sysfs.h>
 #include <linux/thermal.h>
+#include <linux/module.h>
 #include "mt7996.h"
 #include "mac.h"
 #include "mcu.h"
 #include "coredump.h"
 #include "eeprom.h"
+
+static int lp_ctrl = BIT(LOW_POWER_TX_TPO_POWER_BOOST);
+module_param(lp_ctrl, int, 0644);
+MODULE_PARM_DESC(lp_ctrl, "MT7990 low-power/TPO bitmap: bit0 L1SS, bit1 PB-TPO, bit2 LP-TPO, bit3 MinTx-TPO, bit4 Ultra Save, bit5 PST");
 
 static const struct ieee80211_iface_limit if_limits_global = {
 	.max = MT7996_MAX_INTERFACES * MT7996_MAX_RADIOS,
@@ -802,6 +807,66 @@
 		mt7996_unregister_thermal(phy);
 }
 
+static void mt7996_set_pcie_l1ss(struct mt7996_dev *dev, bool en)
+{
+	u8 val = en ? 0x1 : 0xf;
+
+	mt76_rmw(dev, MT_PCIE_MAC_LOW_POWER,
+		 MT_PCIE_MAC_LOW_POWER_DISABLE_MASK,
+		 u32_encode_bits(val, MT_PCIE_MAC_LOW_POWER_DISABLE_MASK));
+	if (dev->hif2)
+		mt76_rmw(dev, MT_PCIE1_MAC_LOW_POWER,
+			 MT_PCIE_MAC_LOW_POWER_DISABLE_MASK,
+			 u32_encode_bits(val, MT_PCIE_MAC_LOW_POWER_DISABLE_MASK));
+}
+
+static void mt7996_low_power_config(struct mt7996_dev *dev)
+{
+#define MT7996_ULTRA_SAVE_CONFIG_ALL		2
+#define MT7996_ULTRA_SAVE_CONFIG_FEATURES	1
+#define MT7996_ULTRA_SAVE_1RPD			4
+#define MT7996_ULTRA_SAVE_DISABLE		0
+	bool pb_en = (lp_ctrl & BIT(LOW_POWER_TX_TPO_POWER_BOOST)) &&
+		     dev->pwr_boost_cap;
+	bool lp_en = lp_ctrl & BIT(LOW_POWER_TX_TPO_POWER_REDUCE);
+	bool min_tx_en = lp_ctrl & BIT(LOW_POWER_TX_TPO_ANTENNA_REDUCE);
+	bool tpo_en = pb_en || lp_en || min_tx_en;
+	bool ok = true;
+	u8 arg[4] = {};
+
+	if (!is_mt7990(&dev->mt76))
+		return;
+
+	ok &= !mt7996_mcu_set_tpo(dev, MT7996_LP_TPO_ALL, tpo_en);
+	ok &= !mt7996_mcu_set_tpo(dev, MT7996_LP_TPO_PB, pb_en ? 3 : 0);
+	ok &= !mt7996_mcu_set_tpo(dev, MT7996_LP_TPO_LP, lp_en ? 3 : 0);
+	ok &= !mt7996_mcu_set_tpo(dev, MT7996_LP_TPO_MIN_TX, min_tx_en ? 3 : 0);
+
+	arg[0] = MT7996_ULTRA_SAVE_CONFIG_ALL;
+	arg[1] = !!(lp_ctrl & BIT(LOW_POWER_RX_ULTRA_SAVE));
+	ok &= !mt7996_mcu_set_lp_option(dev, arg);
+
+	memset(arg, 0, sizeof(arg));
+	arg[0] = MT7996_ULTRA_SAVE_CONFIG_FEATURES;
+	arg[1] = MT7996_ULTRA_SAVE_1RPD;
+	arg[2] = MT7996_ULTRA_SAVE_DISABLE;
+	ok &= !mt7996_mcu_set_lp_option(dev, arg);
+
+	ok &= !mt7996_mcu_set_pst(dev, 0xff, 0,
+		!!(lp_ctrl & BIT(LOW_POWER_TX_PST)));
+
+	mt7996_set_pcie_l1ss(dev,
+		!!(lp_ctrl & BIT(LOW_POWER_PCIE_L1SS)));
+
+	if (ok)
+		dev_info(dev->mt76.dev,
+			 "MT7990 AP profile active: lp_ctrl=0x%x PB-TPO=%u 1RPD=off\n",
+			 lp_ctrl, pb_en);
+	else
+		dev_warn(dev->mt76.dev,
+			 "MT7990 AP profile partially rejected by firmware\n");
+}
+
 static void mt7996_init_work(struct work_struct *work)
 {
 	struct mt7996_dev *dev = container_of(work, struct mt7996_dev,
@@ -813,6 +878,8 @@
 
 	if (!is_mt7990(&dev->mt76))
 		mt7996_mcu_set_dup_wtbl(dev);
+
+	mt7996_low_power_config(dev);
 }
 
 void mt7996_wfsys_reset(struct mt7996_dev *dev)
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -5727,6 +5727,64 @@
 				 &cp_mode, sizeof(cp_mode), true);
 }
 
+int mt7996_mcu_set_tpo(struct mt7996_dev *dev, u8 type, u8 val)
+{
+	struct {
+		u8 __rsv[4];
+		__le16 tag;
+		__le16 len;
+		u8 type;
+		u8 val;
+		u8 __rsv2[2];
+	} __packed req = {
+		.tag = cpu_to_le16(UNI_CMD_TPO_CTRL),
+		.len = cpu_to_le16(sizeof(req) - 4),
+		.type = type,
+		.val = val,
+	};
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WM_UNI_CMD(TPO),
+				 &req, sizeof(req), true);
+}
+
+int mt7996_mcu_set_lp_option(struct mt7996_dev *dev, const u8 *arg)
+{
+	struct {
+		u8 __rsv[4];
+		__le16 tag;
+		__le16 len;
+		u8 arg[4];
+	} __packed req = {
+		.tag = cpu_to_le16(UNI_POWER_LOW_POWER),
+		.len = cpu_to_le16(sizeof(req) - 4),
+	};
+
+	memcpy(req.arg, arg, sizeof(req.arg));
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WM_UNI_CMD(POWER_CTRL),
+				 &req, sizeof(req), false);
+}
+
+int mt7996_mcu_set_pst(struct mt7996_dev *dev, u32 band, u32 cmd, u32 val)
+{
+	struct {
+		u8 __rsv[4];
+		__le16 tag;
+		__le16 len;
+		__le32 band;
+		__le32 cmd;
+		__le32 val;
+	} __packed req = {
+		.tag = cpu_to_le16(UNI_MURU_PST_LOW_POWER),
+		.len = cpu_to_le16(sizeof(req) - 4),
+		.band = cpu_to_le32(band),
+		.cmd = cpu_to_le32(cmd),
+		.val = cpu_to_le32(val),
+	};
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WM_UNI_CMD(MURU),
+				 &req, sizeof(req), false);
+}
+
 int mt7996_mcu_set_dup_wtbl(struct mt7996_dev *dev)
 {
 #define DUP_WTBL_NUM	80
--- a/mt7996/mcu.h
+++ b/mt7996/mcu.h
@@ -870,6 +870,10 @@
 
 enum {
 	UNI_RA_FIXED_RATE = 0xf,
+};
+
+enum {
+	UNI_MURU_PST_LOW_POWER = 0x6e,
 };
 
 #define MT7996_HDR_TRANS_MAX_SIZE	(sizeof(struct hdr_trans_en) +	 \
@@ -1003,6 +1007,7 @@
 
 enum {
 	UNI_POWER_OFF,
+	UNI_POWER_LOW_POWER = 0x6,
 };
 
 enum {
@@ -1078,6 +1083,17 @@
 	MT7996_SEC_MODE_MAX,
 };
 
+enum {
+	UNI_CMD_TPO_CTRL,
+};
+
+enum {
+	MT7996_LP_TPO_ALL,
+	MT7996_LP_TPO_PB,
+	MT7996_LP_TPO_LP,
+	MT7996_LP_TPO_MIN_TX,
+};
+
 #define MT7996_PATCH_SEC		GENMASK(31, 24)
 #define MT7996_PATCH_SCRAMBLE_KEY	GENMASK(15, 8)
 #define MT7996_PATCH_AES_KEY		GENMASK(7, 0)
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -413,6 +413,15 @@
 	} ring[MT7996_MAX_RRO_RRS_RING];
 };
 
+enum {
+	LOW_POWER_PCIE_L1SS,
+	LOW_POWER_TX_TPO_POWER_BOOST,
+	LOW_POWER_TX_TPO_POWER_REDUCE,
+	LOW_POWER_TX_TPO_ANTENNA_REDUCE,
+	LOW_POWER_RX_ULTRA_SAVE,
+	LOW_POWER_TX_PST,
+};
+
 struct mt7996_phy {
 	struct mt76_phy *mt76;
 	struct mt7996_dev *dev;
@@ -509,6 +518,7 @@
 
 	u8 eeprom_mode;
 	bool has_eht:1;
+	bool pwr_boost_cap:1;
 
 	struct {
 		struct {
@@ -985,6 +995,9 @@
 int mt7996_mcu_ps_leave(struct mt7996_dev *dev, struct mt7996_vif_link *link,
 			struct mt7996_sta_link *msta_link);
 int mt7996_mcu_cp_support(struct mt7996_dev *dev, u8 mode);
+int mt7996_mcu_set_tpo(struct mt7996_dev *dev, u8 type, u8 val);
+int mt7996_mcu_set_lp_option(struct mt7996_dev *dev, const u8 *arg);
+int mt7996_mcu_set_pst(struct mt7996_dev *dev, u32 band, u32 cmd, u32 val);
 int mt7996_mcu_set_emlsr_mode(struct mt7996_dev *dev,
 			      struct ieee80211_vif *vif,
 			      struct ieee80211_sta *sta,
--- a/mt7996/regs.h
+++ b/mt7996/regs.h
@@ -750,11 +750,15 @@
 #define MT_PCIE_MAC_BASE			0x74030000
 #define MT_PCIE_MAC(ofs)			(MT_PCIE_MAC_BASE + (ofs))
 #define MT_PCIE_MAC_INT_ENABLE			MT_PCIE_MAC(0x188)
+#define MT_PCIE_MAC_LOW_POWER			MT_PCIE_MAC(0x194)
 
 #define MT_PCIE1_MAC_BASE			0x74090000
 #define MT_PCIE1_MAC(ofs)			(MT_PCIE1_MAC_BASE + (ofs))
 
 #define MT_PCIE1_MAC_INT_ENABLE			MT_PCIE1_MAC(0x188)
+#define MT_PCIE1_MAC_LOW_POWER			MT_PCIE1_MAC(0x194)
+
+#define MT_PCIE_MAC_LOW_POWER_DISABLE_MASK	GENMASK(11, 8)
 
 /* PHYRX CSD */
 #define MT_WF_PHYRX_CSD_BASE			0x83000000
