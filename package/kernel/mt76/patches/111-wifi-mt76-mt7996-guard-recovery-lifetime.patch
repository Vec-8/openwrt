diff --git a/mt7996/init.c b/mt7996/init.c
index 5aada56..5cbd09b 100644
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -1826,6 +1826,8 @@ error:
 
 void mt7996_unregister_device(struct mt7996_dev *dev)
 {
+	WRITE_ONCE(dev->recovery.hw_init_done, false);
+
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->wed_rro.work);
 	cancel_work_sync(&dev->reset_work);
diff --git a/mt7996/mac.c b/mt7996/mac.c
index 570f85d..7ff9442 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2466,6 +2466,10 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 	LIST_HEAD(list);
 	int i;
 
+	if (!READ_ONCE(dev->recovery.hw_init_done) ||
+	    !test_bit(MT76_STATE_REGISTERED, &dev->mphy.state))
+		return;
+
 	dev->recovery.hw_full_reset = true;
 
 	set_bit(MT76_MCU_RESET, &dev->mphy.state);
@@ -2484,8 +2488,13 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 			break;
 	}
 
-	if (i == 10)
+	if (i == 10) {
 		dev_err(dev->mt76.dev, "chip full reset failed\n");
+		dev->recovery.hw_full_reset = false;
+		mutex_unlock(&dev->mt76.mutex);
+
+		return;
+	}
 
 	mt7996_for_each_phy(dev, phy)
 		phy->omac_mask = 0;
@@ -2520,6 +2529,11 @@ mt7996_mac_full_reset(struct mt7996_dev *dev)
 
 	mutex_unlock(&dev->mt76.mutex);
 
+	/* unregister clears hw_init_done before cancelling reset_work */
+	if (!READ_ONCE(dev->recovery.hw_init_done) ||
+	    !test_bit(MT76_STATE_REGISTERED, &dev->mphy.state))
+		return;
+
 	ieee80211_wake_queues(mt76_hw(dev));
 
 	ieee80211_restart_hw(mt76_hw(dev));
diff --git a/mt7996/mcu.c b/mt7996/mcu.c
index c8a9f31..b4e810b 100644
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -229,7 +229,9 @@ mt7996_mcu_parse_response(struct mt76_dev *mdev, int cmd,
 		dev_err(mdev->dev, "Message %08x (seq %d) timeout\n",
 			cmd, seq);
 
-		if (!test_and_set_bit(MT76_MCU_RESET, &dev->mphy.state)) {
+		if (READ_ONCE(dev->recovery.hw_init_done) &&
+		    test_bit(MT76_STATE_REGISTERED, &dev->mphy.state) &&
+		    !test_and_set_bit(MT76_MCU_RESET, &dev->mphy.state)) {
 			dev->recovery.restart = true;
 			wake_up(&dev->mt76.mcu.wait);
 			queue_work(dev->mt76.wq, &dev->reset_work);
diff --git a/mt7996/mt7996.h b/mt7996/mt7996.h
index 673be6d..34bb694 100644
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -490,8 +490,8 @@ struct mt7996_dev {
 		u32 wa_reset_count;
 		u32 wm_reset_count;
 		bool hw_full_reset:1;
-		bool hw_init_done:1;
 		bool restart:1;
+		bool hw_init_done;
 	} recovery;
 
 	/* protects coredump data */
