#!/bin/sh
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'
urldecode() {
  data="$(printf '%s' "$1" | sed 's/+/ /g;s/%/\\x/g')"
  printf '%b' "$data"
}
qs_get() {
  key="$1"
  printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$key=//p" | head -n1
}
name="$(urldecode "$(qs_get name)")"
role="$(urldecode "$(qs_get role)")"
ip="$(urldecode "$(qs_get ip)")"
case "$ip" in *[!0-9.]*|'' ) echo '{"ok":false,"error":"IP invalide"}'; exit 0 ;; esac
echo "$ip" | awk -F. 'NF==4 { for(i=1;i<=4;i++) if($i<0 || $i>255 || $i=="") exit 1; exit 0 } { exit 1 }' || { echo '{"ok":false,"error":"IP invalide"}'; exit 0; }
if uci -q show otb_devices | grep -q "\.ip=\x27$ip\x27"; then echo '{"ok":false,"error":"IP déjà présente"}'; exit 0; fi
[ -n "$name" ] || name="$ip"
[ -n "$role" ] || role="Équipement"
s="$(uci add otb_devices device)"
uci set otb_devices.$s.name="$name"
uci set otb_devices.$s.role="$role"
uci set otb_devices.$s.ip="$ip"
uci commit otb_devices
/usr/sbin/otb-refresh-luci-json >/dev/null 2>&1 || true
echo '{"ok":true}'
