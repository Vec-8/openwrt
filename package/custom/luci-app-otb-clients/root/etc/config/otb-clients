config main 'main'
	option enabled '1'
	option role 'collector'
	option node_id 'auto'
	option node_label 'auto'
	option bridge 'br-lan'
	# Interfaces WAN que le bouton LuCI est autorise a redemarrer.
	list wan_restart_iface 'wan_fibre'
	list wan_restart_iface 'wan5g_primary'
	list wan_restart_iface 'wan5g_backup'
	option interval '15'
	option stale_after '45'
	option history_dir '/tmp/otb-clients'
	option history_limit '250'
	list exclude_port 'bond-trunk'
	list exclude_port 'mxl_lan5'

config node 'pro'
	option enabled '1'
	option local '1'
	option label 'R4 Pro'
	option address '127.0.0.1'

config node 'sud'
	option enabled '0'
	option local '0'
	option label 'R4 Sud'
	option address '192.0.2.2'
	option user 'root'
	option identity '/etc/otb-clients/id_ed25519'

config node 'nord'
	option enabled '0'
	option local '0'
	option label 'R4 Nord'
	option address '192.0.2.3'
	option user 'root'
	option identity '/etc/otb-clients/id_ed25519'

