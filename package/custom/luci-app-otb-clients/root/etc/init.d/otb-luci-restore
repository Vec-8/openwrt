#!/bin/sh /etc/rc.common

START=99
STOP=01

restore_file() {
	local source="$1"
	local target="$2"
	local mode="$3"
	local temporary="${target}.otb-new"

	[ -f "$source" ] || return 0
	if [ -f "$target" ] && cmp -s "$source" "$target"; then
		return 0
	fi

	mkdir -p "${target%/*}" || return 1
	cp "$source" "$temporary" || return 1
	chown root:root "$temporary" || return 1
	chmod "$mode" "$temporary" || return 1
	mv "$temporary" "$target" || return 1
	OTB_LUCI_CHANGED=1
}

start() {
	local source_root='/usr/share/otb-luci-overrides'
	local model hostname

	OTB_LUCI_CHANGED=0

	# Correctif commun aux R4 : résolution des VLAN à travers bond-trunk.
	restore_file "$source_root/29_ports.js" \
		'/www/luci-static/resources/view/status/include/29_ports.js' 0644

	model="$(ubus call system board 2>/dev/null | jsonfilter -e '@.model' 2>/dev/null)"
	hostname="$(uci -q get system.@system[0].hostname)"

	case "$model $hostname" in
		*BPI-R4-PRO*|*BPI-R4-Pro*|*BPI_R4_Pro*|*R4-Pro*|*R4_Pro*)
			restore_file "$source_root/r4pro/usr/sbin/otb-luci-status" \
				'/usr/sbin/otb-luci-status' 0755
			restore_file "$source_root/r4pro/usr/sbin/otb-luci-wan-restart" \
				'/usr/sbin/otb-luci-wan-restart' 0755
			restore_file "$source_root/r4pro/usr/sbin/otb-refresh-luci-json" \
				'/usr/sbin/otb-refresh-luci-json' 0755
			restore_file "$source_root/r4pro/usr/share/rpcd/acl.d/otb-luci-status.json" \
				'/usr/share/rpcd/acl.d/otb-luci-status.json' 0644
			restore_file "$source_root/r4pro/www/cgi-bin/otb-status-json" \
				'/www/cgi-bin/otb-status-json' 0755
			restore_file "$source_root/r4pro/www/cgi-bin/otb-wan-restart" \
				'/www/cgi-bin/otb-wan-restart' 0755
			restore_file "$source_root/r4pro/www/cgi-bin/otb-device-add" \
				'/www/cgi-bin/otb-device-add' 0755
			restore_file "$source_root/r4pro/www/cgi-bin/otb-device-del" \
				'/www/cgi-bin/otb-device-del' 0755
			restore_file "$source_root/r4pro/www/luci-static/resources/view/status/include/92_otb_status.js" \
				'/www/luci-static/resources/view/status/include/92_otb_status.js' 0644
			;;
	esac

	if [ "$OTB_LUCI_CHANGED" = 1 ]; then
		/etc/init.d/rpcd restart >/dev/null 2>&1 || true
		/etc/init.d/uhttpd restart >/dev/null 2>&1 || true
	fi
}

reload_service() {
	start
}
