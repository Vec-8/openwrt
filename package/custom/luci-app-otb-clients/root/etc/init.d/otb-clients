#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

validate_interval() {
	local value
	value="$(uci -q get otb-clients.main.interval)"
	case "$value" in
		''|*[!0-9]*) value=15 ;;
	esac
	[ "$value" -ge 5 ] 2>/dev/null || value=5
	[ "$value" -le 300 ] 2>/dev/null || value=300
	printf '%s' "$value"
}

start_service() {
	local enabled interval
	enabled="$(uci -q get otb-clients.main.enabled)"
	[ "$enabled" = "0" ] && return 0

	interval="$(validate_interval)"
	mkdir -p /tmp/otb-clients

	procd_open_instance otb-clients
	# procd impose HOME=/ par défaut. Dropbear chercherait alors les clés hôtes
	# dans /.ssh et refuserait les nœuds distants malgré leur présence dans
	# /root/.ssh/known_hosts.
	procd_set_param env HOME=/root
	# Le collecteur écrit le JSON complet sur stdout pour l'usage manuel. Ne pas
	# recopier ces données dans logd toutes les quinze secondes.
	procd_set_param command /bin/sh -c "while true; do /usr/bin/ucode /usr/sbin/otb-clients >/dev/null; sleep $interval; done"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "otb-clients"
}
