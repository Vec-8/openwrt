#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
	/usr/libexec/otb-mxl-flowctrl apply
}

stop() {
	# Le retour au mode automatique reste un effort de sécurité au shutdown.
	# Il ne doit toutefois jamais bloquer l'arrêt si le lien est déjà tombé.
	/usr/libexec/otb-mxl-flowctrl runtime-disable >/dev/null 2>&1 || true
}

reload() {
	stop
	start
}
