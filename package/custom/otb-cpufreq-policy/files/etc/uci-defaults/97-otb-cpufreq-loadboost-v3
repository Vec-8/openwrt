#!/bin/sh

# Migration non réseau vers le boost CPU sous charge validé sur les deux R4.
uci -q batch <<'EOF'
set otb-cpufreq.main.profile_version='3'
set otb-cpufreq.main.interval='1'
set otb-cpufreq.main.load_boost='1'
set otb-cpufreq.main.load_high_percent='25'
set otb-cpufreq.main.load_low_percent='10'
set otb-cpufreq.main.boost_hold_seconds='15'
set otb-cpufreq.main.boost_min_freq='1800000'
set otb-cpufreq.main.network_iface='bond-trunk'
set otb-cpufreq.main.network_high_bps='125000000'
set otb-cpufreq.main.network_low_bps='12500000'
commit otb-cpufreq
EOF

/etc/init.d/otb-cpufreq enable >/dev/null 2>&1 || exit 1
/etc/init.d/otb-cpufreq restart >/dev/null 2>&1 || exit 1
exit 0
