#!/bin/sh
set -eu

APPLY=0
RELOAD=0
for arg in "$@"; do
	case "$arg" in
		--apply) APPLY=1 ;;
		--reload) RELOAD=1 ;;
		--no-reload) RELOAD=0 ;;
		*)
			echo "Usage: $0 --apply [--reload|--no-reload]" >&2
			exit 2
			;;
	esac
done
[ "$APPLY" -eq 1 ] || {
	echo "Refus: utiliser --apply" >&2
	exit 2
}

for radio in radio0 radio1 radio2; do
	uci -q get "wireless.${radio}" >/dev/null || {
		echo "Aucune migration: ${radio} absent" >&2
		exit 0
	}
done

get_key() {
	for section in "$@"; do
		value="$(uci -q get "wireless.${section}.key" || true)"
		if [ -n "$value" ]; then
			printf '%s' "$value"
			return 0
		fi
	done
	return 1
}

get_network() {
	fallback="$1"
	shift
	for section in "$@"; do
		value="$(uci -q get "wireless.${section}.network" || true)"
		if [ -n "$value" ]; then
			printf '%s' "$value"
			return 0
		fi
	done
	printf '%s' "$fallback"
}

MAIN_KEY="$(get_key cahier_main_mlo lan_5 lan_6 lan_24 mld_main || true)"
GUEST_KEY="$(get_key cahier_guest_mlo guest_6 guest_5 guest_24 mld_guest || true)"
HOME2_KEY="$(get_key cahier_home2g iot_24 || true)"
HOME5_KEY="$(get_key cahier_home5g_mlo iot_5 iot_5_24 iot_5g mld_iot || true)"

if [ -z "$MAIN_KEY" ] || [ -z "$GUEST_KEY" ] || [ -z "$HOME2_KEY" ] || [ -z "$HOME5_KEY" ]; then
	echo "Aucune migration: profils OTB ou secrets existants incomplets" >&2
	logger -t otb-wifi-cahier "migration ignoree: configuration OTB incomplete"
	exit 0
fi

MAIN_NETWORK="$(get_network lan cahier_main_mlo lan_5 lan_6 lan_24)"
GUEST_NETWORK="$(get_network guest cahier_guest_mlo guest_6 guest_5 guest_24)"
IOT_NETWORK="$(get_network iot cahier_home2g cahier_home5g_mlo iot_24 iot_5 iot_5_24 iot_5g)"

STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="/root/otb-backups/wifi-cahier-v1-${STAMP}"
mkdir -p "$BACKUP"
cp -p /etc/config/wireless "$BACKUP/wireless"
sha256sum "$BACKUP/wireless" >"$BACKUP/SHA256SUMS"

# Le cahier fixe les largeurs maximales, mais conserve les canaux, le pays et
# la puissance configurée propres à chaque point d'accès.
uci set wireless.radio0.htmode='EHT40'
uci set wireless.radio0.noscan='1'
uci set wireless.radio1.htmode='EHT160'
uci set wireless.radio2.htmode='EHT320'

for section in \
	lan_24 lan_5 lan_6 guest_24 guest_5 guest_6 \
	iot_24 iot_5 iot_5_24 iot_5g test_r4pro R4Sud
do
	uci -q get "wireless.${section}" >/dev/null || continue
	uci set "wireless.${section}.disabled=1"
done

for section in cahier_main_mlo cahier_guest_mlo cahier_home2g cahier_home5g_mlo; do
	uci -q delete "wireless.${section}" || true
done

uci set wireless.cahier_main_mlo='wifi-iface'
uci add_list wireless.cahier_main_mlo.device='radio0'
uci add_list wireless.cahier_main_mlo.device='radio1'
uci add_list wireless.cahier_main_mlo.device='radio2'
uci set wireless.cahier_main_mlo.mode='ap'
uci set wireless.cahier_main_mlo.network="$MAIN_NETWORK"
uci set wireless.cahier_main_mlo.ssid='Ti-Kanevedenn'
uci set wireless.cahier_main_mlo.encryption='sae'
uci set wireless.cahier_main_mlo.key="$MAIN_KEY"
uci set wireless.cahier_main_mlo.sae_pwe='2'
uci set wireless.cahier_main_mlo.ieee80211w='2'
uci set wireless.cahier_main_mlo.mlo='1'
uci set wireless.cahier_main_mlo.isolate='0'
uci set wireless.cahier_main_mlo.disassoc_low_ack='0'
uci set wireless.cahier_main_mlo.skip_inactivity_poll='1'
uci set wireless.cahier_main_mlo.max_inactivity='3600'
uci set wireless.cahier_main_mlo.wpa_disable_eapol_key_retries='1'
uci set wireless.cahier_main_mlo.disabled='0'

uci set wireless.cahier_guest_mlo='wifi-iface'
uci add_list wireless.cahier_guest_mlo.device='radio0'
uci add_list wireless.cahier_guest_mlo.device='radio1'
uci add_list wireless.cahier_guest_mlo.device='radio2'
uci set wireless.cahier_guest_mlo.mode='ap'
uci set wireless.cahier_guest_mlo.network="$GUEST_NETWORK"
uci set wireless.cahier_guest_mlo.ssid='Trefflay'
uci set wireless.cahier_guest_mlo.encryption='sae'
uci set wireless.cahier_guest_mlo.key="$GUEST_KEY"
uci set wireless.cahier_guest_mlo.sae_pwe='2'
uci set wireless.cahier_guest_mlo.ieee80211w='2'
uci set wireless.cahier_guest_mlo.mlo='1'
uci set wireless.cahier_guest_mlo.disabled='0'

uci set wireless.cahier_home2g='wifi-iface'
uci set wireless.cahier_home2g.device='radio0'
uci set wireless.cahier_home2g.mode='ap'
uci set wireless.cahier_home2g.network="$IOT_NETWORK"
uci set wireless.cahier_home2g.ssid='Home-2G'
uci set wireless.cahier_home2g.encryption='psk2'
uci set wireless.cahier_home2g.key="$HOME2_KEY"
uci set wireless.cahier_home2g.ieee80211w='0'
uci set wireless.cahier_home2g.disabled='0'

uci set wireless.cahier_home5g_mlo='wifi-iface'
uci add_list wireless.cahier_home5g_mlo.device='radio0'
uci add_list wireless.cahier_home5g_mlo.device='radio1'
uci set wireless.cahier_home5g_mlo.mode='ap'
uci set wireless.cahier_home5g_mlo.network="$IOT_NETWORK"
uci set wireless.cahier_home5g_mlo.ssid='Home-5G'
uci set wireless.cahier_home5g_mlo.encryption='psk2'
uci set wireless.cahier_home5g_mlo.key="$HOME5_KEY"
uci set wireless.cahier_home5g_mlo.ieee80211w='0'
uci set wireless.cahier_home5g_mlo.mlo='1'
uci set wireless.cahier_home5g_mlo.ieee80211k='1'
uci set wireless.cahier_home5g_mlo.bss_transition='1'
uci set wireless.cahier_home5g_mlo.wnm_sleep_mode='1'
uci set wireless.cahier_home5g_mlo.wnm_sleep_mode_no_keys='1'
uci set wireless.cahier_home5g_mlo.disabled='0'

uci commit wireless
mkdir -p /etc/otb
{
	echo "version=1.1"
	echo "applied=${STAMP}"
	echo "backup=${BACKUP}"
} >/etc/otb/wifi-cahier

if [ "$RELOAD" -eq 1 ]; then
	wifi reload
fi

logger -t otb-wifi-cahier "cahier Wi-Fi V1 applique; sauvegarde ${BACKUP}"
echo "WIFI_CAHIER_V1_APPLIED=1"
echo "BACKUP=${BACKUP}"
