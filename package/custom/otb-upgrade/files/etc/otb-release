# Métadonnées immuables de l'image officielle OpenWrt main/Linux 6.18.
# Reste autonome lorsqu'il est sourcé hors de l'outil otb-upgrade.
if [ -z "${BOARD_NAME:-}" ] && command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
	BOARD_NAME="$(ubus call system board 2>/dev/null | jsonfilter -e '@.board_name' 2>/dev/null)"
fi
case "${BOARD_NAME:-}" in
	bananapi,bpi-r4-pro-8x)
		OTB_DEVICE='r4pro'
		OTB_BUILD_ID='r4pro-openwrt-main-6.18.39-fr-be14-mt7996-stock-lifecycle-mlo-preserve-27-27-27-rss-r2-rpsf-rfs0-netprefetch-napi256-dimlock-hwlro-toggle-rxqfix-thermal-shared-no-mxl-pause-luci-fr-wan-heal-v1-20260729'
		OTB_SEQUENCE='2026072933'
		;;
	bananapi,bpi-r4)
		OTB_DEVICE='r4sud'
		OTB_BUILD_ID='r4sud-openwrt-main-6.18.39-fr-be14-mt7996-stock-lifecycle-mlo-preserve-27-27-27-rss-r2-rpsf-rfs0-netprefetch-napi256-dimlock-hwlro-toggle-rxqfix-thermal-aligned-pro-ha-luci-fr-20260729'
		OTB_SEQUENCE='2026072931'
		;;
	*)
		OTB_DEVICE='unsupported'
		OTB_BUILD_ID='unsupported'
		OTB_SEQUENCE='0'
		;;
esac
OTB_CHANNEL='test'
