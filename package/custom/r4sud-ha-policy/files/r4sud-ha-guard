#!/bin/sh /etc/rc.common

START=98
STOP=90

extra_command "apply" "Reinstall the guarded dockerd init script"

SAFE_INIT="/usr/libexec/r4sud-ha-policy/dockerd.init.safe"
DOCKER_INIT="/etc/init.d/dockerd"
STORAGE_MARKER="/srv/.r4sud-ha-storage-ready"

apply() {
	[ -r "$SAFE_INIT" ] || return 1
	cp "$SAFE_INIT" "$DOCKER_INIT" || return 1
	chmod 0755 "$DOCKER_INIT"
}

boot() {
	apply || return 1
	if [ ! -f "$STORAGE_MARKER" ]; then
		"$DOCKER_INIT" stop >/dev/null 2>&1 || true
		"$DOCKER_INIT" disable >/dev/null 2>&1 || true
	fi
}

start() {
	boot
}
